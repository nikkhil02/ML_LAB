import pandas as pd
data={
    "Student_Name" :["Amit", "Riya" ,"Sourav" ,"Aditya","Rahul"],
        "Roll_No" : [10,49,50,5,47],
        "Marks"   : [88,97,78,83,45]
}
df=pd.DataFrame(data)
def cal_grade(Marks):
    if Marks >= 90:
        return "A"
    elif Marks >=80:
        return "B"
    elif Marks >=70:
        return "C"
    elif Marks >=60:
        return "D"
    else:
        return "F"
df["Grade"] = df["Marks"].apply(cal_grade)
print(df)
